+fn CGContextSelectFont(
+    env: &mut Environment,
+    context: CGContextRef,
+    name: ConstPtr<u8>,
+    size: CGFloat,
+    _encoding: u32,
+) {
+    let name = String::from_utf8_lossy(env.mem.cstr_at(name)).to_lowercase();
+    let bold = name.contains("bold");
+    let font = if name.contains("courier") || name.contains("mono") {
+        if bold { Font::mono_bold() } else { Font::mono_regular() }
+    } else if name.contains("times") || name.contains("serif") {
+        if bold { Font::serif_bold() } else { Font::serif_regular() }
+    } else if bold {
+        Font::sans_bold()
+    } else {
+        Font::sans_regular()
+    };
+    let class = env.objc.get_known_class("_touchHLE_CGFont", &mut env.mem);
+    let font = env.objc.alloc_object(class, Box::new(CGFontHostObject { font }), &mut env.mem);
+    CGContextSetFont(env, context, font);
+    CGContextSetFontSize(env, context, size);
+    CGFontRelease(env, font);
+}
+
+fn CGContextShowTextAtPoint(
+    env: &mut Environment,
+    context: CGContextRef,
+    x: CGFloat,
+    y: CGFloat,
+    text: ConstPtr<u8>,
+    length: GuestUSize,
+) {
+    if length == 0 {
+        return;
+    }
+    // The legacy game uses this API for its English labels and numbers.
+    let bytes = env.mem.bytes_at(text, length);
+    let font = env.objc.borrow::<CGContextHostObject>(context).font;
+    let font = &env.objc.borrow::<CGFontHostObject>(font).font;
+    let glyphs: Vec<u16> = bytes.iter().map(|&ch| font.glyph_id_for_char(ch as u16).0).collect();
+    let pointer = env.mem.alloc(length * 2);
+    for (index, glyph) in glyphs.iter().enumerate() {
+        env.mem.write(pointer.cast::<u16>() + index as u32, *glyph);
+    }
+    CGContextShowGlyphsAtPoint(env, context, x, y, pointer.cast_const().cast(), length);
+    env.mem.free(pointer);
+}
