+fn CGContextSelectFont(
+    env: &mut Environment,
+    context: CGContextRef,
+    name: ConstPtr<u8>,
+    size: CGFloat,
+    _encoding: u32,
+) {
+    let name = String::from_utf8_lossy(env.mem.cstr_at(name)).to_lowercase();
+    let bold = name.contains("bold");
+    let font = if name.contains("courier") || name.contains("mono") {
+        if bold { Font::mono_bold() } else { Font::mono_regular() }
+    } else if name.contains("times") || name.contains("serif") {
+        if bold { Font::serif_bold() } else { Font::serif_regular() }
+    } else if bold {
+        Font::sans_bold()
+    } else {
+        Font::sans_regular()
+    };
+    let class = env.objc.get_known_class("_touchHLE_CGFont", &mut env.mem);
+    let font = env.objc.alloc_object(class, Box::new(CGFontHostObject { font }), &mut env.mem);
+    CGContextSetFont(env, context, font);
+    CGContextSetFontSize(env, context, size);
+    CGFontRelease(env, font);
+}
+
+fn CGContextShowTextAtPoint(
