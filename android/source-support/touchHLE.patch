+    let text = crate::localization::visible(env, &text).into_owned();
+    let previous_font = env.objc.borrow::<CGContextHostObject>(context).font;
+    let previous_size = env.objc.borrow::<CGContextHostObject>(context).font_size;
+    let cjk = text.chars().any(|character| character as u32 > 0x2FFF);
+    if cjk {
