+        let origin = ((x0+x1) as f32/2.0, y0 as f32 + ((y1-y0) as f32-text_height)/2.0);
+        let level = if name == "GameUI_HpGauge.png" { 35.0 } else { brightness.max(165) as f32 };
+        for (offset, color) in [(scale as f32 * 0.5, 0.0), (0.0, level)] {
