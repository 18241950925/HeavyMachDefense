+    }
+    CGContextShowGlyphsAtPoint(env, context, x, y, pointer.cast_const().cast(), length);
+    env.mem.free(pointer);
+    if cjk {
+        CGContextSetFont(env, context, previous_font);
+        CGContextSetFontSize(env, context, previous_size);
+        CGFontRelease(env, previous_font);
+    }
