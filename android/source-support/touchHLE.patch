+
+/// Keep a host-only text bitmap alongside the original guest bitmap. All
+/// dimensions exposed to the ARM program and its texture coordinates stay
+/// unchanged; only the final GL texture has more pixels.
+pub(crate) fn draw_high_resolution<F: FnOnce(&mut CGBitmapContextDrawer, f32)>(
+    env: &mut Environment, context: CGContextRef, draw: F,
+) {
+    if !crate::localization::enabled(env) { return; }
+    let host = env.objc.borrow::<CGContextHostObject>(context);
+    let CGContextSubclass::CGBitmapContext(info) = host.subclass;
+    let grayscale = info.color_space == kCGColorSpaceGenericGray
+        && info.bytes_per_row == info.width && info.alpha_info == kCGImageAlphaNone;
+    let rgba = info.color_space == kCGColorSpaceGenericRGB
+        && info.bytes_per_row == info.width * 4 && info.alpha_info == kCGImageAlphaPremultipliedLast;
+    if info.bits_per_component != 8 || (!grayscale && !rgba)
+        || info.width > 1024 || info.height > 1024 {
+        return;
+    }
+    let scale = if info.width > 512 || info.height > 512 { 2 } else { crate::localization::TEXT_SCALE };
+    let mut transform = host.transform;
+    transform.tx *= scale as f32;
+    transform.ty *= scale as f32;
+    let color = host.rgb_fill_color;
+    let blend = host.blend_mode;
+    let pixels = env.mem.bytes_at(info.data.cast(), info.bytes_per_row * info.height);
+    let state = &mut env.framework_state.uikit.localization;
+    let mut canvas = state.canvases.remove(&context.to_bits()).unwrap_or_else(|| {
+        // Grayscale text stores coverage in the color component, with no
+        // alpha component. Preserve it as opaque RGB while drawing, then
+        // extract a color channel when uploading the GL_ALPHA texture.
+        let rgba_pixels = if grayscale {
+            pixels.iter().flat_map(|&gray| [gray, gray, gray, 255]).collect()
+        } else {
+            pixels.to_vec()
+        };
+        crate::localization::Canvas {
+            data: info.data.to_bits(), dimensions: (info.width, info.height),
+            fingerprint: 0, fingerprint_dirty: true, uploaded: false,
+            alpha_fingerprint: 0, alpha_half_fingerprint: 0,
+            grayscale,
+            image: std::rc::Rc::new(Image::from_pixel_vec(rgba_pixels, (info.width, info.height)).enlarged(scale)),
+        }
+    });
+    let image = std::rc::Rc::make_mut(&mut canvas.image);
+    let (width, height) = image.dimensions();
+    let mut drawer = CGBitmapContextDrawer {
+        bitmap_info: CGBitmapContextData { data: Ptr::null(), data_is_owned: false,
+            width, height, bits_per_component: 8, bytes_per_row: width * 4,
+            color_space: kCGColorSpaceGenericRGB, alpha_info: kCGImageAlphaPremultipliedLast },
+        rgb_fill_color: color, blend_mode: blend, transform, pixels: image.pixels_mut(),
+    };
+    draw(&mut drawer, scale as f32);
+    canvas.fingerprint_dirty = true;
+    canvas.uploaded = false;
+    state.canvases.insert(context.to_bits(), canvas);
+}
+
+pub(crate) fn update_high_resolution_fingerprint(env: &mut Environment, context: CGContextRef) {
+    if let Some(canvas) = env.framework_state.uikit.localization.canvases.get_mut(&context.to_bits()) {
+        canvas.fingerprint_dirty = true;
+        canvas.uploaded = false;
+    }
 }
 
